DATABASE_URL="postgresql://user:password@localhost:5432/xonnect?schema=public"
# Use Supabase's direct database connection for Prisma migrations (not the pooler URL).
DIRECT_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
PORT=4000
CORS_ORIGIN="https://xonnect.net,exp://,http://localhost:19006"
APP_BASE_URL="https://api.xonnect.net"

# DropAphi - OTP / transactional email / file storage
DROPAPHI_BASE_URL="https://dropaphi.xyz/api/v1"
DROPAPHI_API_KEY="da_live_your_key"

# Paystack - ticket & video purchases
PAYSTACK_SECRET_KEY="sk_live_or_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_or_test_xxx"

# LiveKit - live event streaming
LIVEKIT_HOST="https://your-project.livekit.cloud"
LIVEKIT_API_KEY="lk_api_key"
LIVEKIT_API_SECRET="lk_api_secret"
